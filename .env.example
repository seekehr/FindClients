# ─────────────────────────────────────────────────────────────
# FindClients — global environment file.
#
# Copy to `.env` in this same directory. Every workspace reads it:
#   server/    via src/config/env.ts (loads ../.env, then server/.env)
#   scrapper/  via the server process it is loaded into
#   website/   via next.config.mjs (only NEXT_PUBLIC_* reach the browser)
#
# `.env` is gitignored. Never commit real keys.
# ─────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────
# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=
# Service-role / secret key (sb_secret_… or the legacy service_role JWT).
# SERVER ONLY. It bypasses Row Level Security — never expose it to the browser.
SUPABASE_SERVICE_KEY=
# Publishable / anon key. Safe for the browser; currently unused because the
# website authenticates through the API server, but handy to have on hand.
SUPABASE_ANON_KEY=
# Create new accounts already email-confirmed instead of sending a verification
# mail. Convenient in development; set to false once SMTP is configured.
SUPABASE_AUTO_CONFIRM_EMAILS=true

# ── API server ────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed origins for CORS (the website dev server).
CORS_ORIGIN=http://localhost:3000

# ── Secrets ───────────────────────────────────────────────
# Key used to encrypt users' stored session cookies at rest (AES-256-GCM).
# CHANGE IN PRODUCTION and keep it secret. In prod, use a KMS instead.
ENCRYPTION_KEY=dev-insecure-encryption-key-change-me

# Shared secret for /api/internal — the service-to-service API the scrapers call
# to fetch each user's config and session. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Leaving it unset disables those routes rather than exposing them unauthenticated.
INTERNAL_API_KEY=
# Where the scrapers reach the server. Only change if the API is not local.
INTERNAL_API_URL=http://localhost:4000/api

# ── AI lead qualification ─────────────────────────────────
# Key for the model that judges whether a scraped lead is actually worth your
# time. Get one at https://console.anthropic.com → API keys.
#
# This is the only AI setting here. WHAT counts as a qualified lead is
# per-user: the prompt, the model, the score threshold and whether rejected
# leads get archived all live in `user_config` and are edited on the app's
# Config page. Leaving this empty disables qualification for everyone; the
# Config page shows that it is unavailable rather than silently passing
# every lead.
ANTHROPIC_API_KEY=

# ── Scheduler ─────────────────────────────────────────────
# Master switch for the background scraping scheduler.
SCHEDULER_ENABLED=true
# Cron expression for how often scraping runs. Default: every 2 minutes.
# Each cycle scrapes on behalf of every user who has connected that platform.
SCRAPE_CRON=*/2 * * * *

# ── Scraper runtime ───────────────────────────────────────
# MACHINE-LEVEL ONLY — these describe the browser this server drives, and are
# the same for every user.
#
# Search settings are NOT here. Keywords, like/view thresholds, per-keyword
# limits, post age windows, the Upwork feed URL and Discord webhooks are all
# PER-USER: they live in the `user_config` table and are edited on the app's
# Config page. The database is their only source of truth, so adding an
# X_KEYWORDS-style variable here would have no effect.

# X / Twitter (scrapper/twitter)
X_HEADLESS=true
# Optional rotating proxies, e.g. http://user:pass@host:port,http://host2:port
X_PROXY_LIST=
# X_USER_AGENT=

# Upwork (scrapper/upwork)
UPWORK_HEADLESS=true
UPWORK_REQUEST_DELAY_MS=1500
UPWORK_DETAIL_TIMEOUT_MS=10000
UPWORK_LOAD_MORE_WAIT_MS=15000
UPWORK_MAX_LOAD_MORE=20
# UPWORK_USER_AGENT=

# ── Website ───────────────────────────────────────────────
# Base URL of the API server, baked into the browser bundle at build time.
NEXT_PUBLIC_API_URL=http://localhost:4000/api
