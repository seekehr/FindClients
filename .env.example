# ─────────────────────────────────────────────────────────────
# FindClients — machine settings.
#
# Copy to `.env` in this same folder (npm run setup does it for you).
# Everything here describes the MACHINE: which port, which browser mode, how
# often to scrape.
#
# What gets scraped is NOT here. Keywords, thresholds, limits, the Upwork feed
# URL, the Discord webhook, the AI criteria and your Gemini key all live in
# data/config.json and are edited on the Config page in the app. Adding a
# KEYWORDS variable here would have no effect.
#
# Every value below is optional — the defaults are the ones in this file.
# ─────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────
PORT=4000

# Which interface to listen on.
#
# There is no login on this app, deliberately: it is yours, on your machine.
# Loopback is what takes the place of one. Changing this to 0.0.0.0 hands
# anyone on your network your leads, your saved Upwork/X sessions and a button
# that starts a scrape. Don't, unless you have put something in front of it.
HOST=127.0.0.1

# Serve the built website from the API process, so there is one port.
# `npm run dev` sets this to false and runs the two separately.
SERVE_WEBSITE=true

# Where the app's data lives, relative to this folder: the JSON files and the
# signed-in browser profiles under browser/. Backing up FindClients means
# copying this folder — and note that it carries your live sessions with it.
DATA_DIR=data

# ── Scheduler ─────────────────────────────────────────────
SCHEDULER_ENABLED=true

# How often to scrape. THIS IS THE SETTING THAT MATTERS MOST.
#
# Scraping runs from your own IP with your own logged-in session, which looks
# like ordinary use — right up until it happens every two minutes, forever, at
# exactly the same offset. That is the pattern that gets an account flagged.
# Every 30 minutes is plenty; the posts are not going anywhere.
#
# This does NOT cover Upwork. Upwork is never scraped — it is watched by a tab
# left open on the feed, and its pacing is set on the Config page in the app,
# under "Upwork job alerts".
SCRAPE_CRON=*/30 * * * *

# Random delay (ms) before each scheduled run actually starts, so cycles don't
# land on a perfectly regular clock tick. 0 disables it.
SCRAPE_JITTER_MS=120000

# Scrape once immediately at startup. Off by default: restarting the app is not
# a reason to hit the platforms again.
SCRAPE_ON_START=false

# ── Browser ───────────────────────────────────────────────
# Attach to a Chrome you started yourself, instead of letting FindClients
# launch one. This is the recommended setup.
#
#   npm run chrome     # starts real Chrome with debugging on, keeps your profile
#
# Sign in to Upwork and X in that window once and leave it open. Every scrape
# reuses it, and the Upwork watcher lives in it — one tab, held open, reloaded
# every few minutes. Because it is an ordinary Chrome you launched, with your
# profile and no automation flags, sites treat it like the browser it is:
# Upwork's Cloudflare wall returns 200 through this and 403 to a launched one.
CHROME_CDP_URL=http://127.0.0.1:9222

# Port and profile for `npm run chrome`. The profile is what makes the login
# stick, so keep it somewhere permanent.
CHROME_DEBUG_PORT=9222
CHROME_PROFILE_DIR=data/chrome-profile
# CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe

# When CHROME_CDP_URL is empty, FindClients launches its own browser against
# data/browser/<platform>/ instead. It uses the installed Google Chrome by
# default; set this empty to force Playwright's bundled Chromium.
# CHROME_CHANNEL=chrome

# ── Bot challenges ────────────────────────────────────────
# When a CAPTCHA or bot wall shows up, wait for you to click through it by hand.
#
# Attached to your own Chrome (CHROME_CDP_URL), the window is already open and
# visible — the scrape just pauses and waits for you to solve it there. Without
# it, the run reopens in a visible window for the same purpose.
#
# Either way this assumes you are at the machine. A scheduled run while you are
# away waits, times out, and loses that one cycle; the next starts clean. Set
# false to skip challenges instead of waiting.
CAPTCHA_OPEN_WINDOW=true
CAPTCHA_TIMEOUT_MS=300000

# ── Scraper runtime ───────────────────────────────────────
# Leave the user agent unset unless you have a reason. The scrapers drive a real
# persistent Chrome profile now, so Chromium's own UA matches the browser that
# is actually running; a pinned string goes stale and becomes a mismatch.

# X / Twitter
X_HEADLESS=true
# Optional rotating proxies, e.g. http://user:pass@host:port,http://host2:port
X_PROXY_LIST=
# X_USER_AGENT=

# Upwork
#
# Upwork is watched, not scraped: FindClients keeps one tab open on your jobs
# feed and tells you about new postings after a random pause. How often it
# reloads and how long it holds a job are decisions about YOUR account, so they
# live on the Config page in the app rather than here.
#
# UPWORK_HEADLESS only affects the one-off session check on the Connections
# page. The watcher itself is never headless — it lives in the Chrome above.
UPWORK_HEADLESS=true
UPWORK_REQUEST_DELAY_MS=1500
UPWORK_DETAIL_TIMEOUT_MS=10000
# UPWORK_USER_AGENT=

# ── Website ───────────────────────────────────────────────
# Where the browser should send API calls. Leave unset: with one port the site
# and the API are the same origin, and a bare /api is correct.
# NEXT_PUBLIC_API_URL=
