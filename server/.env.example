# ── Server ────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed origins for CORS (the website dev server)
CORS_ORIGIN=http://localhost:3000

# ── Auth ──────────────────────────────────────────────────
# Change this in production. Used to sign JWT access tokens.
JWT_SECRET=dev-super-secret-change-me
JWT_EXPIRES_IN=7d

# ── Database ──────────────────────────────────────────────
# SQLite file location (relative to server/). Uses Node's built-in node:sqlite.
DATABASE_FILE=./data/findclients.db

# ── Scheduler / Scrapers ──────────────────────────────────
# Master switch for the background scraping scheduler.
SCHEDULER_ENABLED=true
# Cron expression for how often scraping jobs run. Default: every 2 minutes.
SCRAPE_CRON=*/2 * * * *
# When true, built-in demo scrapers generate synthetic leads so the pipeline
# is visibly alive even before the real scrapers in ../scrapper are implemented.
USE_DEMO_SCRAPERS=true

# ── Notifications (stubs) ─────────────────────────────────
# Optional Discord webhook the notification service will POST to (leave blank to skip).
DISCORD_WEBHOOK_URL=
